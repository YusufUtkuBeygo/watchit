# compose.prod.yaml için ayarlar. Bu dosyayı ".env.prod" olarak kopyala ve değerleri doldur.
# .env.prod repoya girmez (.gitignore). Gerçek şifreleri buraya (örnek dosyaya) yazma.
DB_PASSWORD=uzun-rastgele-bir-sifre
